<?xml version="1.0"?>
<ruleset name="AgencyWPBase">
  <description>WordPress Coding Standards configuration for agency custom themes and plugins.</description>

  <file>./theme</file>
  <file>./plugin</file>

  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*.asset.php</exclude-pattern>
  <exclude-pattern>*.min.js</exclude-pattern>
  <exclude-pattern>*.min.css</exclude-pattern>

  <arg value="ps"/>
  <arg name="extensions" value="php"/>
  <arg name="colors"/>

  <config name="testVersion" value="8.0-"/>
  <config name="minimum_wp_version" value="6.5"/>

  <rule ref="WordPress-Core"/>
  <rule ref="WordPress-Extra"/>
  <rule ref="WordPress-Docs"/>
  <rule ref="PHPCompatibilityWP"/>

  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="agency-base"/>
        <element value="agency-base-site"/>
      </property>
    </properties>
  </rule>
</ruleset>
